# ============================================
# CodeSentinel Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual API keys
# ============================================

# Primary Groq API Key (required)
VITE_GROQ_API_KEY=your_groq_api_key_here

# Additional Groq API Keys for Load Balancing (optional, but recommended)
# The system will rotate through these keys to handle rate limits
# Having multiple keys allows for better throughput and resilience
VITE_GROQ_API_KEY_1=your_groq_api_key_1
VITE_GROQ_API_KEY_2=your_groq_api_key_2
VITE_GROQ_API_KEY_3=your_groq_api_key_3
VITE_GROQ_API_KEY_4=your_groq_api_key_4
VITE_GROQ_API_KEY_5=your_groq_api_key_5
VITE_GROQ_API_KEY_6=your_groq_api_key_6
VITE_GROQ_API_KEY_7=your_groq_api_key_7
VITE_GROQ_API_KEY_8=your_groq_api_key_8
VITE_GROQ_API_KEY_9=your_groq_api_key_9
VITE_GROQ_API_KEY_10=your_groq_api_key_10

# ============================================
# FALLBACK AI PROVIDERS (All Free Tiers)
# ============================================
# These are used as fallbacks when Groq is rate-limited
# Having multiple providers increases reliability

# Google Gemini API (Free: 15 RPM, 1500 RPD)
# Get key at: https://makersuite.google.com/app/apikey
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# HuggingFace Inference API (Free tier available)
# Get key at: https://huggingface.co/settings/tokens
VITE_HUGGINGFACE_API_KEY=your_huggingface_api_key_here

# Together AI (Free tier available)
# Get key at: https://api.together.xyz/settings/api-keys
VITE_TOGETHER_API_KEY=your_together_api_key_here

# Optional: Analytics
VITE_ANALYTICS_ID=your_analytics_id

# ============================================
# How to get API Keys:
# ============================================
# 
# 1. GROQ (Primary - Fastest)
#    URL: https://console.groq.com/keys
#    - Sign up for free at https://groq.com
#    - Create API keys in the console
#    - Free tier: 30 requests/minute per key
#    - Recommended: Get 10 keys for load balancing
#
# 2. GOOGLE GEMINI (Fallback - Good for complex analysis)
#    URL: https://makersuite.google.com/app/apikey
#    - Sign in with Google account
#    - Create new API key
#    - Free tier: 15 requests/minute, 1500/day
#    - Model: gemini-1.5-flash (free)
#
# 3. HUGGINGFACE (Fallback - Code analysis)
#    URL: https://huggingface.co/settings/tokens
#    - Create free account
#    - Generate new token
#    - Free inference API available
#    - Models: Mixtral, CodeLlama
#
# 4. TOGETHER AI (Fallback - Additional capacity)
#    URL: https://api.together.xyz/settings/api-keys
#    - Sign up for free account
#    - Generate API key
#    - Free tier with credits
#
# ============================================
